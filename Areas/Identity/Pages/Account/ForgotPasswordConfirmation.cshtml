@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Check your email</h1>
    <p class="fr-auth-lead">If there is an account with that email, we've sent it a link to choose a new password.</p>
    <p class="fr-auth-alt"><a class="fr-auth-link" asp-page="./Login">Back to log in</a></p>
</section>
