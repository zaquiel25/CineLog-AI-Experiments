@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Confirm email</h1>

    @if (Model.StatusMessage == null)
    {
        <p class="fr-auth-lead">Confirming your email…</p>
    }
    else if (Model.StatusMessage.StartsWith("Error"))
    {
        <p class="fr-auth-lead fr-form-errors" role="alert">@Model.StatusMessage</p>
        <p class="fr-auth-alt"><a class="fr-auth-link" asp-page="./ResendEmailConfirmation">Send a new link</a></p>
    }
    else
    {
        <p class="fr-auth-lead">@Model.StatusMessage</p>
        <a asp-page="./Login" class="fr-btn fr-btn--block">Log in</a>
    }
</section>
