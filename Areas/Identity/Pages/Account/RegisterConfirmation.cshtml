@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Check your email</h1>
    <p class="fr-auth-lead">We sent a confirmation link to <strong>@Model.Email</strong>. Open it to start logging films.</p>
    <p class="fr-auth-alt">Nothing there? Check your spam folder or <a class="fr-auth-link" asp-page="./ResendEmailConfirmation">send it again</a>.</p>
    <p class="fr-auth-alt"><a class="fr-auth-link" asp-page="./Login">Back to log in</a></p>
</section>
