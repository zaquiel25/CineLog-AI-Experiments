@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Log in</h1>

    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="fr-form-errors" role="alert"></div>

        <div class="fr-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email"></span>
        </div>

        <div class="fr-field">
            <label asp-for="Input.Password">Password</label>
            <div class="fr-field-pw">
                <input asp-for="Input.Password" autocomplete="current-password" aria-required="true" />
                <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Input.Password"></span>
        </div>

        <div class="fr-auth-row">
            <label>
                <input asp-for="Input.RememberMe" />
                Remember me
            </label>
            <a id="forgot-password" class="fr-auth-link" asp-page="./ForgotPassword">Forgot password?</a>
        </div>

        <button id="login-submit" type="submit" class="fr-btn fr-btn--block">Log in</button>
    </form>

    @* Hide external login section when no providers are configured *@
    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="fr-auth-or">or</div>
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @* SECURITY: Add anti-forgery token protection for external login *@
            @Html.AntiForgeryToken()
            @foreach (var provider in Model.ExternalLogins!)
            {
                <button type="submit" class="fr-btn fr-btn--secondary fr-btn--block" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                    <i class="@(provider.Name.ToLower() == "google" ? "fab fa-google" : "fas fa-sign-in-alt")" aria-hidden="true"></i>Continue with @provider.DisplayName
                </button>
            }
        </form>
    }

    <p class="fr-auth-alt">New to FrameRoute? <a class="fr-auth-link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up</a></p>
    <p class="fr-auth-alt">No confirmation email? <a id="resend-confirmation" class="fr-auth-link" asp-page="./ResendEmailConfirmation">Send it again</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
