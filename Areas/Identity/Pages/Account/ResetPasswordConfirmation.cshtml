@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password saved";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Password saved</h1>
    <p class="fr-auth-lead">Your new password is ready. Log in with it.</p>
    <a asp-page="./Login" class="fr-btn fr-btn--block">Log in</a>
</section>
