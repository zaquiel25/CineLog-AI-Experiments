@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Confirm your email</h1>
    <p class="fr-auth-lead">Enter your email and we'll send the confirmation link again.</p>

    <form method="post">
        <div asp-validation-summary="All" class="fr-form-errors" role="alert"></div>
        <div class="fr-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="email" aria-required="true" />
            <span asp-validation-for="Input.Email"></span>
        </div>
        <button type="submit" class="fr-btn fr-btn--block">Send link</button>
    </form>

    <p class="fr-auth-alt"><a class="fr-auth-link" asp-page="./Login">Back to log in</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
