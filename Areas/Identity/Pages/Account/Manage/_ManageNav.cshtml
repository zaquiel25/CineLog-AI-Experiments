@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    // ManageNavPages returns "active" for the current page; the bar uses the My Movies tab class
    string? Tab(string? navClass) => navClass == "active" ? "is-active" : null;
    string? Current(string? navClass) => navClass == "active" ? "page" : null;
}
<div class="fr-mm-bar">
    <nav class="fr-mm-tabs" aria-label="Account sections">
        <a class="@Tab(ManageNavPages.IndexNavClass(ViewContext))" aria-current="@Current(ManageNavPages.IndexNavClass(ViewContext))" id="profile" asp-page="./Index">Profile</a>
        <a class="@Tab(ManageNavPages.EmailNavClass(ViewContext))" aria-current="@Current(ManageNavPages.EmailNavClass(ViewContext))" id="email" asp-page="./Email">Email</a>
        <a class="@Tab(ManageNavPages.ChangePasswordNavClass(ViewContext))" aria-current="@Current(ManageNavPages.ChangePasswordNavClass(ViewContext))" id="change-password" asp-page="./ChangePassword">Password</a>
        @if (hasExternalLogins)
        {
            <a class="@Tab(ManageNavPages.ExternalLoginsNavClass(ViewContext))" aria-current="@Current(ManageNavPages.ExternalLoginsNavClass(ViewContext))" id="external-login" asp-page="./ExternalLogins">External logins</a>
        }
        <a class="@Tab(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext))" aria-current="@Current(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext))" id="two-factor" asp-page="./TwoFactorAuthentication">Two-factor</a>
        <a class="@Tab(ManageNavPages.PersonalDataNavClass(ViewContext))" aria-current="@Current(ManageNavPages.PersonalDataNavClass(ViewContext))" id="personal-data" asp-page="./PersonalData">Personal data</a>
    </nav>
</div>
