@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />
<p class="fr-account-text">You log in with an external account. Add a password to log in with your email too.</p>

<form id="set-password-form" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="fr-form-errors" role="alert"></div>
    <div class="fr-field">
        <label asp-for="Input.NewPassword">New password</label>
        <div class="fr-field-pw">
            <input asp-for="Input.NewPassword" autocomplete="new-password" />
            <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.NewPassword"></span>
    </div>
    <div class="fr-field">
        <label asp-for="Input.ConfirmPassword">Confirm password</label>
        <div class="fr-field-pw">
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit" class="fr-btn">Save password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
