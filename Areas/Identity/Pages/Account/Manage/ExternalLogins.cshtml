@*
    External logins (e.g. Google). Users cannot remove their last way to log in (ShowRemoveButton).
*@
@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "External logins";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="_StatusMessage" for="StatusMessage" />

@if (Model.CurrentLogins?.Count > 0)
{
    <ul class="fr-account-list">
        @foreach (var login in Model.CurrentLogins)
        {
            <li>
                <span id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</span>
                @if (Model.ShowRemoveButton)
                {
                    <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post">
                        <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                        <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                        <button type="submit" class="fr-log-delete" title="Remove this @login.ProviderDisplayName login from your account">Disconnect</button>
                    </form>
                }
            </li>
        }
    </ul>
}

@if (Model.OtherLogins?.Count > 0)
{
    <p class="fr-account-text">Log in with another account instead of your password.</p>
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post">
        @foreach (var provider in Model.OtherLogins)
        {
            <button id="@($"link-login-button-{provider.Name}")" type="submit" name="provider" value="@provider.Name"
                    class="fr-btn fr-btn--secondary" title="Log in using your @provider.DisplayName account">
                <i class="@(provider.Name == "Google" ? "fab fa-google" : "fas fa-right-left")" aria-hidden="true" style="margin-right:10px"></i>Connect @provider.DisplayName
            </button>
        }
    </form>
}
