@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="fr-form-errors" role="alert"></div>
    <div class="fr-field">
        <label asp-for="Input.OldPassword">Current password</label>
        <div class="fr-field-pw">
            <input asp-for="Input.OldPassword" autocomplete="current-password" type="password" />
            <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.OldPassword"></span>
    </div>
    <div class="fr-field">
        <label asp-for="Input.NewPassword">New password</label>
        <div class="fr-field-pw">
            <input asp-for="Input.NewPassword" autocomplete="new-password" type="password" />
            <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.NewPassword"></span>
        <span class="fr-field-hint">At least 8 characters.</span>
    </div>
    <div class="fr-field">
        <label asp-for="Input.ConfirmPassword">Confirm new password</label>
        <div class="fr-field-pw">
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" type="password" />
            <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
        </div>
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit" class="fr-btn">Save password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
