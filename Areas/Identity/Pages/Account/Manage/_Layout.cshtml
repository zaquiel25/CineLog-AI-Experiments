@*
    Account (Identity Manage): title, the sections as tabs on a bar (same as My Movies) and one narrow form.
    Also wraps the Identity UI pages that are not scaffolded here (Email, Two-factor, Personal data).
*@
@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="fr-account">
    <h1 class="fr-account-title">Account</h1>
    <p class="fr-account-sub">@User.Identity?.Name</p>
    <partial name="_ManageNav" />
    <div class="fr-account-body">
        @RenderBody()
    </div>
</section>

@* FIX: re-declare the section so page scripts render after jQuery in the main layout.
   RenderSection here printed them mid-page, before jQuery loaded ("jQuery is not defined"). *@
@section Scripts {
    @RenderSection("Scripts", required: false)
}
