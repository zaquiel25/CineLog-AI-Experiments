@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="fr-form-errors" role="alert"></div>
    <div class="fr-field">
        <label asp-for="Input.DisplayName">Display name</label>
        <input asp-for="Input.DisplayName" autocomplete="nickname" />
        <span asp-validation-for="Input.DisplayName"></span>
        <span class="fr-field-hint">Shown instead of your email. Leave it empty to use your email.</span>
    </div>
    <button id="update-profile-button" type="submit" class="fr-btn">Save changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
