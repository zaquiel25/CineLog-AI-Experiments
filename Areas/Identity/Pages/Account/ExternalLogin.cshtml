@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Sign up";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Sign up with @Model.ProviderDisplayName</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="fr-auth-lead fr-form-errors" role="alert">@Model.ErrorMessage</p>
    }

    <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        @* SECURITY: Add anti-forgery token protection *@
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="fr-form-errors" role="alert"></div>
        <p class="fr-auth-lead">You're signed in with <strong>@Model.ProviderDisplayName</strong>. Confirm the email for your FrameRoute account to finish.</p>
        <div class="fr-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="email" />
            <span asp-validation-for="Input.Email"></span>
        </div>
        <button type="submit" class="fr-btn fr-btn--block">Sign up</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
