@page
@model RegisterModel
@{
    ViewData["Title"] = "Sign up";
}

<section class="fr-auth">
    <h1 class="fr-page-kicker">Sign up</h1>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="fr-form-errors" role="alert"></div>
        @* SECURITY: Honeypot field — hidden from humans, bots fill it automatically *@
        <div class="fr-honeypot" aria-hidden="true">
            <input type="text" name="Website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="fr-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" aria-required="true" />
            <span asp-validation-for="Input.Email"></span>
        </div>

        <div class="fr-field">
            <label asp-for="Input.Password">Password</label>
            <div class="fr-field-pw">
                <input asp-for="Input.Password" autocomplete="new-password" aria-required="true" />
                <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Input.Password"></span>
        </div>

        <div class="fr-field">
            <label asp-for="Input.ConfirmPassword">Confirm password</label>
            <div class="fr-field-pw">
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-required="true" />
                <button class="fr-pw-toggle" type="button" tabindex="-1" aria-label="Show password" data-pw-toggle><i class="bi bi-eye"></i></button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>

        <button id="registerSubmit" type="submit" class="fr-btn fr-btn--block">Sign up</button>
    </form>

    @* Hide external login section when no providers are configured *@
    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="fr-auth-or">or</div>
        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @Html.AntiForgeryToken()
            @foreach (var provider in Model.ExternalLogins!)
            {
                <button type="submit" class="fr-btn fr-btn--secondary fr-btn--block" name="provider" value="@provider.Name" title="Sign up using your @provider.DisplayName account">
                    <i class="@(provider.Name.ToLower() == "google" ? "fab fa-google" : "fas fa-user-plus")" aria-hidden="true"></i>Continue with @provider.DisplayName
                </button>
            }
        </form>
    }

    <p class="fr-auth-alt">Already have an account? <a class="fr-auth-link" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
