@*
    One suggested movie. Main action: save to wishlist. Secondary actions ("I've seen it",
    "Not interested") live in the "•••" menu. Rendered both in Suggest.cshtml and server-side
    for AJAX responses (RenderPartialViewToStringAsync), so keep it self-contained.
*@
@model Ezequiel_Movies.Models.TmdbApi.TmdbMovieBrief

@{
    var year = !string.IsNullOrEmpty(Model.ReleaseDate) && Model.ReleaseDate.Length >= 4 ? Model.ReleaseDate.Substring(0, 4) : null;
    var inWishlist = Model.IsInWishlist == true;
}

<article class="fr-suggest-card" id="movie-card-@Model.Id">
    <a class="fr-suggest-poster" asp-controller="Movies" asp-action="Preview" asp-route-tmdbId="@Model.Id" tabindex="-1" aria-hidden="true">
        @if (!string.IsNullOrEmpty(Model.PosterPath))
        {
            <img src="https://image.tmdb.org/t/p/w342@(Model.PosterPath)" alt="" width="342" height="513" />
        }
        else
        {
            <span class="fr-wall-fallback">@Model.Title</span>
        }
    </a>

    <a class="fr-film-title fr-suggest-title" asp-controller="Movies" asp-action="Preview" asp-route-tmdbId="@Model.Id">@Model.Title</a>
    <p class="fr-suggest-meta">
        @year
        @if (Model.IsWatched == true)
        {
            <span class="fr-tag">Watched</span>
        }
    </p>

    <div class="fr-suggest-actions">
        @if (inWishlist)
        {
            <button type="button" class="fr-btn fr-btn--secondary fr-btn--compact" disabled>In your wishlist</button>
        }
        else
        {
            <form class="wishlist-form" method="post" action="/Movies/AddToWishlist">
                @Html.AntiForgeryToken()
                <input type="hidden" name="tmdbId" value="@Model.Id" />
                <button type="submit" class="fr-btn fr-btn--secondary fr-btn--compact wishlist-btn">Save to Wishlist</button>
            </form>
        }

        <details class="fr-more">
            <summary aria-label="More actions for @Model.Title"><span aria-hidden="true">•••</span></summary>
            <div class="fr-more-menu">
                <a asp-controller="Movies" asp-action="Add" asp-route-tmdbId="@Model.Id">I've seen it</a>
                @* Not interested = blacklist. Hidden when the movie is already in the wishlist (mutually exclusive) *@
                @if (!inWishlist)
                {
                    <form class="blacklist-form" method="post" action="/Movies/AddToBlacklist">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="tmdbId" value="@Model.Id" />
                        <button type="submit" class="blacklist-btn">Not interested</button>
                    </form>
                }
            </div>
        </details>
    </div>
</article>
