@using Microsoft.AspNetCore.Identity
@using Ezequiel_Movies.Services

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject UserDisplayNameService DisplayNameService
@{
    string? displayName = null;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            var username = UserManager.GetUserName(User) ?? "User";
            displayName = await DisplayNameService.GetDisplayNameAsync(currentUser.Id, username);
        }
    }
}
<ul class="fr-nav-account">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a id="manage" class="fr-nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage your account">@displayName</a>
    </li>
    <li>
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="fr-nav-link fr-nav-button">Log out</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="fr-nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </li>
    <li>
        <a class="fr-nav-link fr-nav-link--strong" id="register" asp-area="Identity" asp-page="/Account/Register">Sign up</a>
    </li>
}
</ul>
