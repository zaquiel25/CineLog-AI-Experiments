<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FrameRoute</title>
    @{
        // FEATURE: Dynamic OG tags — movie pages override these via ViewData, all other pages use defaults
        var ogTitle = ViewData["OgTitle"] as string ?? "FrameRoute: We Know What You Should Watch Next";
        var ogDescription = ViewData["OgDescription"] as string ?? "Log what you watch. We pick what's next, based on your favorite genres, directors, and ratings. Not the same 10 movies everyone recommends.";
        var ogImage = ViewData["OgImage"] as string ?? "https://frameroute.net/images/og-image.png";
        var ogUrl = ViewData["OgUrl"] as string ?? "https://frameroute.net";
        var seoDescription = ViewData["SeoDescription"] as string ?? "Log movies and get recommendations based on what you actually like: your genres, directors, and ratings. Free movie tracker with smart suggestions.";
    }
    <!-- SEO -->
    <meta name="description" content="@seoDescription">
    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:title" content="@ogTitle">
    <meta property="og:description" content="@ogDescription">
    <meta property="og:image" content="@ogImage">
    <meta property="og:url" content="@ogUrl">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="FrameRoute">
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@@framerouteapp">
    <meta name="twitter:title" content="@ogTitle">
    <meta name="twitter:description" content="@ogDescription">
    <meta name="twitter:image" content="@ogImage">
    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png">
    <link rel="manifest" href="~/site.webmanifest">
    <meta name="theme-color" content="#F4D03F">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="FrameRoute">
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha384-t1nt8BQoYMLFN5p42tRAtuAAFQaCQODekUVeKKZrEnEyp4H2R0RHFz0KWpmj7i8g" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/spacing-enhancements.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vertical-centering.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ezequiel_Movies.styles.css" asp-append-version="true" />
    @* 2026 redesign system (see DESIGN.md). Loaded last so its tokens win over legacy styles. *@
    <link rel="stylesheet" href="~/css/frameroute.css" asp-append-version="true" />
</head>
<body>
    @* We create a new wrapper div to control the flex layout, avoiding theme conflicts on the body tag *@
    <div class="d-flex flex-column min-vh-100">

        @{
            // Marks the current section in the nav (hand-drawn underline, see DESIGN.md)
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
            // "Not interested" (Blacklist action) is a tab of the Wishlist page, so it lights up Wishlist
            string NavState(params string[] actions) =>
                currentController == "Movies" && actions.Contains(currentAction) ? "fr-nav-link is-active" : "fr-nav-link";
        }
        <header class="fr-header">
            <nav class="fr-nav" aria-label="Main">
                <a class="fr-nav-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo-gold.svg" alt="FrameRoute" width="26" height="28">
                </a>
                <button class="fr-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#frNavMenu"
                        aria-controls="frNavMenu" aria-expanded="false" aria-label="Open menu">
                    <span></span><span></span>
                </button>
                <div class="fr-nav-menu collapse" id="frNavMenu">
                    <ul class="fr-nav-links">
                        <li><a class="@NavState("Add")" asp-area="" asp-controller="Movies" asp-action="Add">Log a movie</a></li>
                        <li><a class="@NavState("List")" asp-area="" asp-controller="Movies" asp-action="List">My Movies</a></li>
                        <li><a class="@NavState("Wishlist", "Blacklist")" asp-area="" asp-controller="Movies" asp-action="Wishlist">Wishlist</a></li>
                        <li><a class="@NavState("Suggest")" asp-area="" asp-controller="Movies" asp-action="Suggest">Suggestions</a></li>
                    </ul>
                    <partial name="_LoginPartial.cshtml" />
                </div>
            </nav>
        </header>


        <main role="main" class="pb-5 flex-grow-1">
            <div class="container">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show mt-2" role="alert">
                        @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>

        @* A div with role="contentinfo" instead of <footer>: legacy site.css forces gold on the footer element with !important *@
        <div class="fr-footer" role="contentinfo">
            <div class="fr-footer-inner">
                <div class="fr-footer-top">
                    <a class="fr-footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo-gold.svg" alt="FrameRoute" width="22" height="24">
                        <span>FrameRoute</span>
                    </a>
                    <ul class="fr-footer-links">
                        <li><a asp-area="" asp-controller="Movies" asp-action="Add">Log a movie</a></li>
                        <li><a asp-area="" asp-controller="Movies" asp-action="List">My Movies</a></li>
                        <li><a asp-area="" asp-controller="Movies" asp-action="Wishlist">Wishlist</a></li>
                        <li><a asp-area="" asp-controller="Movies" asp-action="Suggest">Suggestions</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="FreeApp">Get the app</a></li>
                    </ul>
                    <div class="fr-footer-social">
                        <a href="https://instagram.com/framerouteapp" target="_blank" rel="noopener noreferrer" aria-label="FrameRoute on Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://x.com/framerouteapp" target="_blank" rel="noopener noreferrer" aria-label="FrameRoute on X"><i class="bi bi-twitter-x"></i></a>
                        <a href="mailto:appcinelog@gmail.com" aria-label="Email FrameRoute"><i class="bi bi-envelope"></i></a>
                        <a href="https://www.facebook.com/FrameRoute" target="_blank" rel="noopener noreferrer" aria-label="FrameRoute on Facebook"><i class="bi bi-facebook"></i></a>
                    </div>
                </div>
                <div class="fr-footer-bottom">
                    <span>&copy; @DateTime.Now.Year FrameRoute &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></span>
                    <span class="fr-footer-tmdb">
                        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" aria-label="TMDB">
                            <img src="~/images/tmdb-logo.svg" alt="TMDB" width="60" height="8">
                        </a>
                        This website uses TMDB and the TMDB APIs but is not endorsed, certified, or otherwise approved by TMDB.
                    </span>
                </div>
            </div>
        </div>

    </div> @* This closes the new wrapper div *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <!-- PWA Service Worker -->
    <script>
    if ('serviceWorker' in navigator) {
      // Auto-reload when a new service worker takes control (one-time, no loop)
      let refreshing = false;
      navigator.serviceWorker.addEventListener('controllerchange', () => {
        if (!refreshing) {
          refreshing = true;
          window.location.reload();
        }
      });
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js', { updateViaCache: 'none' })
          .then(reg => {
            console.log('SW registered:', reg.scope);
            reg.update();
          })
          .catch(err => console.log('SW registration failed:', err));
      });
    }
    </script>
</body>
</html>
