@*
    Get the app: FrameRoute is a PWA, so it installs from the browser. One column with the steps per device
    (the tab for the visitor's device opens first) and, where the browser allows it (Chrome/Edge on Android
    and computers), a one-tap "Install FrameRoute" button. Behaviour lives in wwwroot/js/get-app.js.
*@
@{
    ViewData["Title"] = "Get the app";
}

<section class="fr-app">
    <h1 class="fr-page-kicker">Get the app</h1>
    <p class="fr-app-lead">FrameRoute installs from the browser. <strong>No app store, free</strong>, and it opens in its own window like any app.</p>

    <div class="fr-mm-bar">
        <nav class="fr-mm-tabs" role="tablist" aria-label="Your device">
            <a href="#iphone" role="tab" id="tab-iphone" aria-controls="iphone" data-device-tab="iphone">iPhone</a>
            <a href="#android" role="tab" id="tab-android" aria-controls="android" data-device-tab="android">Android</a>
            <a href="#computer" role="tab" id="tab-computer" aria-controls="computer" data-device-tab="computer">Computer</a>
        </nav>
    </div>

    <div id="iphone" class="fr-app-panel" role="tabpanel" aria-labelledby="tab-iphone" data-device-panel="iphone">
        <ol class="fr-app-steps">
            <li>Open frameroute.net in Safari and tap Share <i class="bi bi-box-arrow-up" aria-hidden="true"></i><span>The square with an arrow, at the bottom of the screen.</span></li>
            <li>Tap "Add to Home Screen"<span>Scroll down the list if you don't see it.</span></li>
            <li>Tap "Add"<span>FrameRoute shows up on your home screen.</span></li>
        </ol>
    </div>

    <div id="android" class="fr-app-panel" role="tabpanel" aria-labelledby="tab-android" data-device-panel="android">
        <ol class="fr-app-steps">
            <li>Open frameroute.net in Chrome and tap the menu <i class="bi bi-three-dots-vertical" aria-hidden="true"></i><span>Top right corner.</span></li>
            <li>Tap "Install app" or "Add to Home screen"<span>The name changes a little between phones.</span></li>
            <li>Confirm<span>FrameRoute shows up on your home screen.</span></li>
        </ol>
    </div>

    <div id="computer" class="fr-app-panel" role="tabpanel" aria-labelledby="tab-computer" data-device-panel="computer">
        <ol class="fr-app-steps">
            <li>Open frameroute.net in Chrome or Edge and click the install icon <i class="bi bi-box-arrow-down" aria-hidden="true"></i><span>On the right side of the address bar.</span></li>
            <li>Click "Install"<span>FrameRoute opens in its own window. You'll find it with your other apps.</span></li>
        </ol>
    </div>

    @* Shown by get-app.js only when the browser offers installation (beforeinstallprompt) *@
    <div class="fr-app-install" data-install hidden>
        <button type="button" class="fr-btn" data-install-button>Install FrameRoute</button>
        <span>or follow the steps above.</span>
    </div>
    <p class="fr-app-installed" data-installed hidden>FrameRoute is installed on this device.</p>
</section>

@section Scripts {
    <script src="~/js/get-app.js" asp-append-version="true"></script>
}
