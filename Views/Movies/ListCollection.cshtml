@*
    My Movies, Collection view: a wall of posters, one tile per unique film.
    Stats are a single line of text. Edit/Delete act on the latest viewing of each film.
*@
@using Ezequiel_Movies.Helpers
@using Ezequiel_Movies.Models
@model PaginatedList<Ezequiel_Movies1.Models.CollectionMovieViewModel>

@{
    ViewData["Title"] = "My Movies - Collection";
    var movieCount = ViewData["MovieCount"] as int? ?? 0;
    var totalWatches = ViewData["TotalWatches"] as int? ?? 0;
    var rewatches = Math.Max(0, totalWatches - movieCount);
    var favoriteTitle = ViewData["FavoriteMovie"]?.ToString();
    var favoriteCount = ViewData["FavoriteMovieWatchCount"] as int? ?? 0;
    var hasSearch = !string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString());
}

<section class="fr-mm">
    <partial name="_MyMoviesHeader" />

    @if (movieCount > 0)
    {
        <p class="fr-mm-stats">
            <b>@movieCount @(movieCount == 1 ? "film" : "films")</b>
            · @totalWatches @(totalWatches == 1 ? "viewing" : "viewings")
            @if (rewatches > 0)
            {
                <text>· @rewatches @(rewatches == 1 ? "rewatch" : "rewatches")</text>
            }
            @if (favoriteCount > 1 && !string.IsNullOrEmpty(favoriteTitle))
            {
                <text>· most rewatched: <span class="fr-film-title-inline">@favoriteTitle</span> (@favoriteCount times)</text>
            }
        </p>
    }

    @if (!Model.Any())
    {
        <div class="fr-empty">
            @if (hasSearch)
            {
                <p class="fr-empty-title">No movies match your search.</p>
                <a class="fr-link" href="@Url.Action("List", new { view = "collection" })">Show all movies</a>
            }
            else
            {
                <p class="fr-empty-title">Your collection is empty.</p>
                <p class="fr-empty-text">Every film you log appears here once, with how many times you watched it.</p>
            }
        </div>
    }
    else
    {
        <div class="fr-wall" data-movie-list>
            @foreach (var item in Model)
            {
                var movie = item.Movie;
                var title = string.IsNullOrWhiteSpace(movie.Title) ? "Untitled" : movie.Title;

                <article class="fr-wall-item" data-movie-row>
                    <a class="fr-wall-poster" asp-action="Details" asp-route-id="@movie.Id" tabindex="-1" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(movie.PosterPath))
                        {
                            <img src="https://image.tmdb.org/t/p/w342@(movie.PosterPath)" alt="" width="342" height="513" loading="lazy" />
                        }
                        else
                        {
                            <span class="fr-wall-fallback">@title</span>
                        }
                    </a>
                    <div class="fr-wall-info">
                        <a class="fr-film-title" asp-action="Details" asp-route-id="@movie.Id">@title</a>
                        <details class="fr-more">
                            <summary aria-label="More actions for @title"><span aria-hidden="true">•••</span></summary>
                            <div class="fr-more-menu">
                                <a asp-action="Edit" asp-route-id="@movie.Id">Edit latest viewing</a>
                                <button type="button" class="is-danger" data-delete-movie data-movie-id="@movie.Id" data-movie-title="@title" data-delete-latest>Delete latest viewing</button>
                            </div>
                        </details>
                    </div>
                    <div class="fr-wall-meta">
                        <partial name="_RatingDots" model="movie.UserRating" />
                        @if (item.WatchCount > 1)
                        {
                            <span class="fr-tag">@item.WatchCount×</span>
                        }
                    </div>
                </article>
            }
        </div>

        <partial name="_MyMoviesPagination" model="(Model.PageIndex, Model.TotalPages)" />
    }

    @* Anti-forgery token for the delete request *@
    <form hidden>@Html.AntiForgeryToken()</form>
</section>

@section Scripts {
    <script src="~/js/my-movies.js" asp-append-version="true"></script>
}
