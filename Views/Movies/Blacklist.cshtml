@*
    Wishlist page, "Not interested" tab: movies hidden from Suggestions (the user's blacklist).
    A compact list, newest first. "Show in suggestions again" removes it via fetch (wwwroot/js/lists.js).
*@
@model Ezequiel_Movies.Helpers.PaginatedList<Ezequiel_Movies.Models.BlacklistViewModel>

@{
    ViewData["Title"] = "Not interested";
    ViewData["ListsTab"] = "hidden";
    ViewData["PaginationAction"] = "Blacklist";
    var today = DateTime.Now.Date;

    // "today", "yesterday", "3 days ago", then a short date
    string HiddenWhen(DateTime date)
    {
        var days = (today - date.Date).Days;
        if (days <= 0) return "today";
        if (days == 1) return "yesterday";
        if (days < 7) return $"{days} days ago";
        return date.Year == today.Year ? date.ToString("MMM d") : date.ToString("MMM d, yyyy");
    }
}

<section class="fr-mm">
    <partial name="_ListsHeader" />

    @if (!Model.Any())
    {
        <div class="fr-empty">
            <p class="fr-empty-title">Nothing hidden.</p>
            <p class="fr-empty-text">When you mark a suggestion as "Not interested", it lands here and stops showing up.</p>
        </div>
    }
    else
    {
        <p class="fr-lists-sub">These never show up in your suggestions.</p>

        <ul class="fr-hidden-list" data-list>
            @foreach (var item in Model)
            {
                var title = string.IsNullOrWhiteSpace(item.Title) ? "Untitled" : item.Title;
                var hasDirector = !string.IsNullOrEmpty(item.Director) && !item.Director.StartsWith("Unknown");
                var meta = string.Join(" · ", new[] { item.ReleasedYear > 0 ? item.ReleasedYear.ToString() : null, hasDirector ? item.Director : null }.Where(s => s != null));

                <li class="fr-hidden-row" data-list-item>
                    <a class="fr-hidden-poster" asp-action="Preview" asp-route-tmdbId="@item.TmdbId" tabindex="-1" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(item.PosterUrl))
                        {
                            <img src="https://image.tmdb.org/t/p/w92@(item.PosterUrl)" alt="" width="40" height="60" loading="lazy" />
                        }
                    </a>
                    <div class="fr-hidden-info">
                        <a class="fr-film-title" asp-action="Preview" asp-route-tmdbId="@item.TmdbId">@title</a>
                        @if (!string.IsNullOrEmpty(meta))
                        {
                            <p class="fr-hidden-meta">@meta</p>
                        }
                    </div>
                    <span class="fr-hidden-when">Hidden @HiddenWhen(item.BlacklistedDate)</span>
                    <details class="fr-more">
                        <summary aria-label="More actions for @title"><span aria-hidden="true">•••</span></summary>
                        <div class="fr-more-menu">
                            <button type="button" data-list-remove="blacklist" data-tmdb-id="@item.TmdbId" data-title="@title">Show in suggestions again</button>
                        </div>
                    </details>
                </li>
            }
        </ul>

        <partial name="_MyMoviesPagination" model="(Model.PageIndex, Model.TotalPages)" />
    }

    @* Anti-forgery token for the remove request *@
    <form hidden>@Html.AntiForgeryToken()</form>
</section>

@section Scripts {
    <script src="~/js/lists.js" asp-append-version="true"></script>
}
