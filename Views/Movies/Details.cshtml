@*
    Movie page for one of the user's viewings. Same layout as Preview, plus the log read back as a
    sentence (same words as the Add form). Main action: "Log again". Edit / Delete live in the "•••" menu.
*@
@model Ezequiel_Movies1.Models.Entities.Movies
@using Ezequiel_Movies.Models

@{
    ViewData["Title"] = Model.Title;
    var tmdb = ViewData["TmdbDetails"] as Ezequiel_Movies.Models.TmdbApi.TmdbMovieDetails;
    var cast = ViewData["Cast"] as List<Ezequiel_Movies.Models.TmdbApi.TmdbCastPerson>;
    var trailerUrl = ViewData["TrailerUrl"] as string;
    var runtime = tmdb?.Runtime;
    var metaParts = new List<string?>
    {
        Model.ReleasedYear?.ToString(),
        runtime > 0 ? $"{runtime / 60}h {runtime % 60}m" : null,
        string.IsNullOrEmpty(Model.Genres) ? null : Model.Genres,
        string.IsNullOrEmpty(Model.Director) || Model.Director == "N/A" ? null : $"Directed by {Model.Director}",
        tmdb?.VoteAverage > 0 ? $"TMDB {tmdb.VoteAverage:0.0}" : null
    };
    var where = Model.WatchedLocation switch
    {
        WatchedLocationType.Home => "at home",
        WatchedLocationType.Cinema => "at the cinema",
        WatchedLocationType.Other => "somewhere else",
        _ => null
    };
}

<article class="fr-movie">
    <div class="fr-movie-poster">
        @if (!string.IsNullOrEmpty(Model.PosterPath))
        {
            <img src="https://image.tmdb.org/t/p/w500@(Model.PosterPath)" alt="@Model.Title poster" width="500" height="750" />
        }
        else
        {
            <span class="fr-wall-fallback">@Model.Title</span>
        }
    </div>

    <div class="fr-movie-body">
        <h1 class="fr-movie-title">@Model.Title</h1>
        <p class="fr-movie-meta">@string.Join(" · ", metaParts.Where(p => !string.IsNullOrEmpty(p)))</p>
        @if (!string.IsNullOrEmpty(tmdb?.Tagline))
        {
            <p class="fr-movie-tagline">@tmdb.Tagline</p>
        }

        @* The log, read back with the same words as the Add sentence *@
        <div class="fr-movie-log">
            <p>
                You watched it
                @if (Model.IsRewatch) { <b>again</b> }
                @if (Model.DateWatched.HasValue)
                {
                    <text>on <b>@Model.DateWatched.Value.ToString("dddd, MMMM d" + (Model.DateWatched.Value.Year != DateTime.Today.Year ? ", yyyy" : ""), System.Globalization.CultureInfo.InvariantCulture)</b></text>
                }
                else
                {
                    <b>some time ago</b>
                }@if (where != null) {<text>, <b>@where</b></text>}@if (Model.UserRating > 0)
                {
                    <text>, and gave it </text><partial name="_RatingDots" model="Model.UserRating" />
                }
                else
                {
                    <text>.</text>
                }
            </p>
        </div>

        <div class="fr-movie-actions">
            <a class="fr-btn" asp-action="Add" asp-route-tmdbId="@Model.TmdbId">Log again</a>
            @if (trailerUrl != null)
            {
                <a class="fr-btn fr-btn--secondary" href="@trailerUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-fill" aria-hidden="true"></i> Trailer</a>
            }
            <details class="fr-more">
                <summary aria-label="More actions for @Model.Title"><span aria-hidden="true">•••</span></summary>
                <div class="fr-more-menu">
                    <a asp-action="Edit" asp-route-id="@Model.Id">Edit this viewing</a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm-delete="@Model.Title">
                        <button type="submit" class="is-danger">Delete this viewing</button>
                    </form>
                </div>
            </details>
        </div>

        @if (!string.IsNullOrEmpty(Model.Overview))
        {
            <p class="fr-movie-overview">@Model.Overview</p>
        }

        <partial name="_MovieCast" model="cast" />
        @if (Model.TmdbId.HasValue)
        {
            <partial name="_MovieWhereToWatch" />
        }
    </div>
</article>

@section Scripts {
    <script src="~/js/movie-page.js" asp-append-version="true"></script>
}
