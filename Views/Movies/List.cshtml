@*
    My Movies, Journal view: a diary of everything the user watched.
    Grouped by month when sorted by watch date; one row per viewing.
    Filters live in _MyMoviesHeader (single GET form). Delete runs via fetch in my-movies.js.
*@
@using Ezequiel_Movies.Helpers
@model PaginatedList<Ezequiel_Movies1.Models.Entities.Movies>

@{
    ViewData["Title"] = "My Movies - FrameRoute";
    var currentSort = ViewData["CurrentSort"]?.ToString() ?? "datewatched_desc";
    var groupByMonth = currentSort.StartsWith("datewatched");
    var hasFilters = !string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString())
                     || !string.IsNullOrEmpty(ViewData["CurrentMonthFilter"]?.ToString())
                     || Context.Request.Query["firstWatchOnly"].ToString() == "true";
    string? currentMonthKey = null;
}

<section class="fr-mm">
    <partial name="_MyMoviesHeader" />

    @if (!Model.Any())
    {
        <div class="fr-empty">
            @if (hasFilters)
            {
                <p class="fr-empty-title">No movies match these filters.</p>
                <a class="fr-link" href="@Url.Action("List", new { view = "journal" })">Show all movies</a>
            }
            else
            {
                <p class="fr-empty-title">Your journal is empty.</p>
                <p class="fr-empty-text">Log the first film you watched and it will show up here, by date.</p>
            }
        </div>
    }
    else
    {
        <div class="fr-diary" data-movie-list>
            @foreach (var movie in Model)
            {
                var watched = movie.DateWatched;
                if (groupByMonth && watched.HasValue)
                {
                    var monthKey = watched.Value.ToString("yyyy-MM");
                    if (monthKey != currentMonthKey)
                    {
                        currentMonthKey = monthKey;
                        <h2 class="fr-diary-month">@watched.Value.ToString("MMMM yyyy")</h2>
                    }
                }

                var title = string.IsNullOrWhiteSpace(movie.Title) ? "Untitled" : movie.Title;
                var location = movie.WatchedLocation?.ToString();
                var meta = new[] { movie.Director, movie.ReleasedYear?.ToString(), location }
                    .Where(part => !string.IsNullOrWhiteSpace(part));

                <article class="fr-diary-row" data-movie-row>
                    @if (watched.HasValue)
                    {
                        <time class="fr-diary-day" datetime="@watched.Value.ToString("yyyy-MM-dd")" title="@watched.Value.ToString("d MMMM yyyy")">
                            <b>@watched.Value.Day</b>
                            <small>@(groupByMonth ? watched.Value.ToString("ddd") : watched.Value.ToString("MMM yy"))</small>
                        </time>
                    }
                    else
                    {
                        <span class="fr-diary-day" aria-label="No watch date"><b>·</b></span>
                    }

                    <a class="fr-diary-poster" asp-action="Details" asp-route-id="@movie.Id" tabindex="-1" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(movie.PosterPath))
                        {
                            <img src="https://image.tmdb.org/t/p/w154@(movie.PosterPath)" alt="" width="52" height="78" loading="lazy" />
                        }
                    </a>

                    <div class="fr-diary-info">
                        <a class="fr-film-title" asp-action="Details" asp-route-id="@movie.Id">@title</a>
                        @if (movie.IsRewatch)
                        {
                            <span class="fr-tag">Rewatch</span>
                        }
                        <p class="fr-diary-meta">@string.Join(" · ", meta)</p>
                    </div>

                    <div class="fr-diary-rating">
                        <partial name="_RatingDots" model="movie.UserRating" />
                    </div>

                    <details class="fr-more">
                        <summary aria-label="More actions for @title"><span aria-hidden="true">•••</span></summary>
                        <div class="fr-more-menu">
                            <a asp-action="Edit" asp-route-id="@movie.Id">Edit</a>
                            <button type="button" class="is-danger" data-delete-movie data-movie-id="@movie.Id" data-movie-title="@title">Delete</button>
                        </div>
                    </details>
                </article>
            }
        </div>

        <partial name="_MyMoviesPagination" model="(Model.PageIndex, Model.TotalPages)" />
    }

    @* Anti-forgery token for the delete request *@
    <form hidden>@Html.AntiForgeryToken()</form>
</section>

@section Scripts {
    <script src="~/js/my-movies.js" asp-append-version="true"></script>
}
