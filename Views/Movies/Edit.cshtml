@*
    Edit one viewing. Same form as step 2 of "Log a movie" (sentence on desktop, chips on mobile), filled with
    the saved values and driven by the same wwwroot/js/log-movie.js. The film itself cannot be changed here:
    a wrong film is deleted and logged again.
*@
@model Ezequiel_Movies.Models.AddMoviesViewModel
@using Ezequiel_Movies.Models

@{
    ViewData["Title"] = "Edit " + Model.Title;
    var meta = string.Join(" · ", new[]
    {
        Model.ReleasedYear?.ToString(),
        string.IsNullOrEmpty(Model.Director) || Model.Director == "N/A" ? null : Model.Director
    }.Where(s => s != null));
    var location = Model.WatchedLocation?.ToString() ?? WatchedLocationType.Home.ToString();
    var movieUrl = Model.TmdbId.HasValue ? Url.Action("Preview", new { tmdbId = Model.TmdbId }) : Url.Action("Details", new { id = Model.Id });
}

<section class="fr-log-page">
    <form asp-action="Edit" asp-controller="Movies" method="post" id="logForm">
        <p class="fr-page-kicker fr-log-kicker">Edit this viewing</p>

        <div class="fr-log" data-step="log">
            <a class="fr-log-poster" href="@movieUrl" aria-label="More about @Model.Title">
                <img alt="" width="342" height="513"
                     src="@(string.IsNullOrEmpty(Model.PosterPath) ? "" : "https://image.tmdb.org/t/p/w342" + Model.PosterPath)"
                     hidden="@string.IsNullOrEmpty(Model.PosterPath)" />
            </a>

            @* Mobile header: title, year · director *@
            <div class="fr-log-head">
                <h1 class="fr-log-film"><a href="@movieUrl">@Model.Title</a></h1>
                <p class="fr-log-meta">@meta</p>
            </div>

            @* Desktop: the sentence (a div, not a p: the <details> menus inside are block-level) *@
            <div class="fr-log-sentence">
                I watched <a class="fr-log-sentence-film" href="@movieUrl">@Model.Title</a>
                <details class="fr-more fr-log-pick" data-pick="rewatch">
                    <summary aria-label="First time or rewatch"><span data-pick-label>@(Model.IsRewatch ? "again" : "for the first time")</span></summary>
                    <div class="fr-more-menu" role="menu">
                        <button type="button" role="menuitemradio" data-value="false">for the first time</button>
                        <button type="button" role="menuitemradio" data-value="true">again</button>
                    </div>
                </details>
                <details class="fr-more fr-log-pick" data-pick="when">
                    <summary aria-label="When"><span data-pick-label>today</span></summary>
                    <div class="fr-more-menu" role="menu">
                        <button type="button" role="menuitemradio" data-value="today">today</button>
                        <button type="button" role="menuitemradio" data-value="yesterday">yesterday</button>
                        <button type="button" role="menuitemradio" data-value="date">on a date…</button>
                        <button type="button" role="menuitemradio" data-value="unknown">some time ago</button>
                    </div>
                </details><label class="fr-log-inline fr-log-inline--date" hidden>
                    <span class="visually-hidden">Date watched</span>
                    <input type="date" data-field="date" />
                </label>,
                <details class="fr-more fr-log-pick" data-pick="where">
                    <summary aria-label="Where"><span data-pick-label>at home</span></summary>
                    <div class="fr-more-menu" role="menu">
                        <button type="button" role="menuitemradio" data-value="Home">at home</button>
                        <button type="button" role="menuitemradio" data-value="Cinema">at the cinema</button>
                        <button type="button" role="menuitemradio" data-value="Other">somewhere else</button>
                    </div>
                </details>,
                and I'd give it
                <span class="fr-log-dots" data-rating tabindex="0" role="slider" aria-label="Your rating"
                      aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" aria-valuetext="No rating">
                    <i></i><i></i><i></i><i></i><i></i>
                </span>
            </div>
            <p class="fr-log-meta fr-log-meta--desktop">@meta</p>

            @* Mobile: the same choices as chips *@
            <div class="fr-log-fields">
                <div class="fr-log-field">
                    <span class="fr-log-label" id="whenLabel">When did you watch it?</span>
                    <div class="fr-log-chips" role="radiogroup" aria-labelledby="whenLabel">
                        <button type="button" class="fr-chip" role="radio" data-chip="when" data-value="today">Today</button>
                        <button type="button" class="fr-chip" role="radio" data-chip="when" data-value="yesterday">Yesterday</button>
                        <button type="button" class="fr-chip" role="radio" data-chip="when" data-value="date">Pick a date</button>
                        <button type="button" class="fr-chip" role="radio" data-chip="when" data-value="unknown">I don't remember</button>
                    </div>
                    <label class="fr-log-date" hidden>
                        <span class="visually-hidden">Date watched</span>
                        <input type="date" data-field="date" />
                    </label>
                </div>
                <div class="fr-log-field">
                    <span class="fr-log-label" id="whereLabel">Where?</span>
                    <div class="fr-log-chips" role="radiogroup" aria-labelledby="whereLabel">
                        <button type="button" class="fr-chip" role="radio" data-chip="where" data-value="Home">Home</button>
                        <button type="button" class="fr-chip" role="radio" data-chip="where" data-value="Cinema">Cinema</button>
                        <button type="button" class="fr-chip" role="radio" data-chip="where" data-value="Other">Other</button>
                    </div>
                </div>
                <div class="fr-log-field">
                    <span class="fr-log-label">Your rating</span>
                    <span class="fr-log-dots" data-rating tabindex="0" role="slider" aria-label="Your rating"
                          aria-valuemin="0" aria-valuemax="5" aria-valuenow="0" aria-valuetext="No rating">
                        <i></i><i></i><i></i><i></i><i></i>
                    </span>
                    <span class="fr-log-rating-text" data-rating-text>No rating</span>
                </div>
                <div class="fr-log-field">
                    <label class="fr-toggle">
                        <input type="checkbox" data-field="rewatch-check" checked="@Model.IsRewatch" />
                        <span>Rewatch</span>
                    </label>
                </div>
            </div>

            <div class="fr-log-actions">
                <button type="submit" class="fr-btn">Save changes</button>
                <a class="fr-btn fr-btn--secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                @* Posts the separate delete form below (forms cannot be nested) *@
                <button type="submit" class="fr-log-delete" form="deleteViewingForm">Delete this viewing</button>
            </div>

            <div class="fr-log-errors">
                <div asp-validation-summary="ModelOnly"></div>
                <span asp-validation-for="DateWatched"></span>
                <span asp-validation-for="UserRating"></span>
            </div>
        </div>

        @* The values that are actually posted. Film fields only travel for validation and redisplay; the server ignores them. *@
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Title" data-hidden="title" />
        <input type="hidden" name="Director" value="@(string.IsNullOrEmpty(Model.Director) ? "N/A" : Model.Director)" data-hidden="director" />
        <input type="hidden" asp-for="ReleasedYear" data-hidden="year" />
        <input type="hidden" asp-for="PosterPath" data-hidden="poster" />
        <input type="hidden" asp-for="Overview" data-hidden="overview" />
        <input type="hidden" asp-for="TmdbId" data-hidden="tmdbId" />
        <input type="hidden" name="DateWatched" value="@Model.DateWatched?.ToString("yyyy-MM-dd")" data-hidden="date" />
        <input type="hidden" name="WatchedLocation" value="@location" data-hidden="where" />
        <input type="hidden" name="IsRewatch" value="@(Model.IsRewatch ? "true" : "false")" data-hidden="rewatch" />
        <input type="hidden" name="UserRating" value="@Model.UserRating?.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)" data-hidden="rating" />
    </form>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" id="deleteViewingForm" data-confirm-delete="@Model.Title"></form>
</section>

@section Scripts {
    <script src="~/js/log-movie.js" asp-append-version="true"></script>
}
