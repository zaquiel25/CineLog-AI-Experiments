@*
    Suggestions: a row of chips picks the starting point; results load below via AJAX
    (server-rendered HTML from MoviesController.RenderSuggestionResultsHtml). Without JS,
    chips fall back to regular links and the results render in this view (Model != null).
*@
@using Ezequiel_Movies.Models.TmdbApi
@model List<TmdbMovieBrief>

@{
    ViewData["Title"] = "Movie Suggestions";
    var genreList = ViewData["GenreSuggestions"] as List<TmdbGenre>;
    var chips = new[]
    {
        ("trending", "Trending"),
        ("genre_recent", "By genre"),
        ("director_recent", "By director"),
        ("cast_recent", "By cast"),
        ("year_recent", "By decade"),
        ("surprise_me", "Surprise me")
    };
}

<section class="fr-suggest">
    <h1 class="fr-page-title">Find your next movie</h1>
    <p class="fr-page-sub">Pick a starting point. Suggestions come from what you logged.</p>

    <nav class="fr-chips" aria-label="Suggestion types">
        @foreach (var (type, label) in chips)
        {
            var href = type == "surprise_me"
                ? Url.Action("GetSurpriseSuggestion")
                : Url.Action("ShowSuggestions", new { suggestionType = type });
            <a class="fr-chip" href="@href" data-suggestion-type="@type">@label</a>
        }
    </nav>

    <div id="suggestion-results-slot">
        @if (Model != null)
        {
            var nextType = ViewData["NextSuggestionType"] as string;
            var canShuffle = Model.Any() && nextType != null &&
                (nextType.StartsWith("trending") || nextType.StartsWith("cast_") || nextType.StartsWith("director_") ||
                 nextType.StartsWith("year_") || nextType.StartsWith("genre_") || nextType == "surprise_me");
            var baseType = nextType == null ? null :
                nextType.StartsWith("year_") ? "decade" :
                nextType.StartsWith("genre_") ? "genre" :
                nextType == "surprise_me" ? "surprise" :
                (nextType.Contains('_') ? nextType.Split('_')[0] : nextType);

            <div id="suggestion-results-area" class="fr-suggest-results">
                <div id="suggestion-header" class="fr-suggest-head">
                    @if (!string.IsNullOrEmpty(ViewData["ActorProfilePath"]?.ToString()))
                    {
                        <img id="actor-profile-image" class="fr-suggest-avatar" src="https://image.tmdb.org/t/p/w185@(ViewData["ActorProfilePath"])" alt="" width="44" height="44" />
                    }
                    <h2 id="suggestion-title" class="fr-suggest-heading">@ViewData["SuggestionTitle"]</h2>
                    @if (canShuffle)
                    {
                        <button type="button" class="reshuffle-btn fr-btn fr-btn--secondary fr-btn--compact" data-suggestion-type="@baseType">Shuffle</button>
                    }
                </div>

                @if (Model.Any())
                {
                    <div id="suggestion-grid" class="fr-suggest-grid">
                        @foreach (var movie in Model)
                        {
                            <partial name="_MovieSuggestionCard" model="movie" />
                        }
                    </div>
                }
                else if ((bool?)ViewData["ShowAddMovieButton"] == true)
                {
                    <div class="fr-empty">
                        <p class="fr-empty-title">Log a few movies first.</p>
                        <p class="fr-empty-text">Suggestions are built from your journal: the more you log, the better they get.</p>
                        <a asp-action="Add" class="fr-btn">Log a movie</a>
                    </div>
                }
                else if (!string.IsNullOrEmpty(nextType))
                {
                    <a class="fr-btn fr-btn--secondary" asp-action="ShowSuggestions" asp-route-suggestionType="@nextType" asp-route-query="@ViewData["NextQuery"]" asp-route-page="@ViewData["NextPage"]">Try again</a>
                }
            </div>
        }
        else if (genreList != null && genreList.Any())
        {
            <div id="suggestion-results-area" class="fr-suggest-results">
                <div class="fr-suggest-head">
                    <h2 class="fr-suggest-heading">@ViewData["SuggestionTitle"]</h2>
                </div>
                <p class="fr-page-sub">Based on genres from your logged movies.</p>
                <nav class="fr-chips" aria-label="Genres">
                    @foreach (var genre in genreList)
                    {
                        <a class="fr-chip" asp-action="ShowSuggestions" asp-route-suggestionType="movies_by_genre" asp-route-query="@genre.Id">@genre.Name</a>
                    }
                </nav>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/suggestions.js" asp-append-version="true"></script>
}
