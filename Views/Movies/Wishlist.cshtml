@*
    Wishlist page, "Want to see" tab: a poster wall like My Movies > Collection.
    "I've seen it" opens the log form for the film; "Remove" deletes it via fetch (wwwroot/js/lists.js).
*@
@model Ezequiel_Movies.Helpers.PaginatedList<Ezequiel_Movies.Models.WishlistViewModel>

@{
    ViewData["Title"] = "Wishlist";
    ViewData["ListsTab"] = "want";
    ViewData["PaginationAction"] = "Wishlist";
    var currentFilter = ViewData["CurrentFilter"]?.ToString();
}

<section class="fr-mm">
    <partial name="_ListsHeader" />

    @if (!Model.Any())
    {
        <div class="fr-empty">
            @if (!string.IsNullOrEmpty(currentFilter))
            {
                <p class="fr-empty-title">No movies match your search.</p>
                <a class="fr-link" asp-action="Wishlist">Show all movies</a>
            }
            else
            {
                <p class="fr-empty-title">Your wishlist is empty.</p>
                <p class="fr-empty-text">Save movies from Suggestions and they will wait for you here.</p>
            }
        </div>
    }
    else
    {
        <div class="fr-wall@(Model.Count == 1 ? " fr-wall--single" : "")" data-list>
            @foreach (var item in Model)
            {
                var title = string.IsNullOrWhiteSpace(item.Title) ? "Untitled" : item.Title;
                var hasDirector = !string.IsNullOrEmpty(item.Director) && !item.Director.StartsWith("Unknown");
                var meta = string.Join(" · ", new[] { item.ReleasedYear > 0 ? item.ReleasedYear.ToString() : null, hasDirector ? item.Director : null }.Where(s => s != null));

                <article class="fr-wall-item" data-list-item>
                    <a class="fr-wall-poster" asp-action="Preview" asp-route-tmdbId="@item.TmdbId" tabindex="-1" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(item.PosterPath))
                        {
                            <img src="https://image.tmdb.org/t/p/w342@(item.PosterPath)" alt="" width="342" height="513" loading="lazy" />
                        }
                        else
                        {
                            <span class="fr-wall-fallback">@title</span>
                        }
                    </a>
                    <div class="fr-wall-info">
                        <a class="fr-film-title" asp-action="Preview" asp-route-tmdbId="@item.TmdbId">@title</a>
                        <details class="fr-more">
                            <summary aria-label="More actions for @title"><span aria-hidden="true">•••</span></summary>
                            <div class="fr-more-menu">
                                <a asp-action="Add" asp-route-tmdbId="@item.TmdbId">I've seen it</a>
                                <button type="button" class="is-danger" data-list-remove="wishlist" data-tmdb-id="@item.TmdbId" data-title="@title">Remove from Wishlist</button>
                            </div>
                        </details>
                    </div>
                    @if (!string.IsNullOrEmpty(meta))
                    {
                        <p class="fr-wall-sub">@meta</p>
                    }
                </article>
            }
        </div>

        <partial name="_MyMoviesPagination" model="(Model.PageIndex, Model.TotalPages)" />
    }

    @* Anti-forgery token for the remove request *@
    <form hidden>@Html.AntiForgeryToken()</form>
</section>

@section Scripts {
    <script src="~/js/lists.js" asp-append-version="true"></script>
}
