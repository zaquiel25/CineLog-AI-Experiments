@*
    Movie page for a film from TMDB (not necessarily logged). Layout shared with Details:
    poster on the left (sticky), everything else on the right. Main action: "Log it" (opens Add with the film).
*@
@model Ezequiel_Movies.Models.TmdbApi.TmdbMovieDetails

@{
    ViewData["Title"] = Model.Title;
    var isAlreadyLogged = (bool)(ViewData["IsAlreadyLogged"] ?? false);
    var isInWishlist = (bool)(ViewData["IsInWishlist"] ?? false);
    var isInBlacklist = (bool)(ViewData["IsInBlacklist"] ?? false);
    var trailerUrl = ViewData["TrailerUrl"] as string;
    var year = !string.IsNullOrEmpty(Model.ReleaseDate) && Model.ReleaseDate.Length >= 4 ? Model.ReleaseDate[..4] : null;
    var director = Model.GetDirector();
    var metaParts = new List<string?>
    {
        year,
        Model.Runtime > 0 ? $"{Model.Runtime / 60}h {Model.Runtime % 60}m" : null,
        Model.Genres.Any() ? string.Join(", ", Model.Genres.Select(g => g.Name)) : null,
        string.IsNullOrEmpty(director) ? null : $"Directed by {director}",
        Model.VoteAverage > 0 ? $"TMDB {Model.VoteAverage:0.0}" : null
    };
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<article class="fr-movie">
    <div class="fr-movie-poster">
        @if (!string.IsNullOrEmpty(Model.PosterPath))
        {
            <img src="https://image.tmdb.org/t/p/w500@(Model.PosterPath)" alt="@Model.Title poster" width="500" height="750" />
        }
        else
        {
            <span class="fr-wall-fallback">@Model.Title</span>
        }
    </div>

    <div class="fr-movie-body">
        <h1 class="fr-movie-title">@Model.Title</h1>
        <p class="fr-movie-meta">@string.Join(" · ", metaParts.Where(p => !string.IsNullOrEmpty(p)))</p>
        @if (!string.IsNullOrEmpty(Model.Tagline))
        {
            <p class="fr-movie-tagline">@Model.Tagline</p>
        }

        @if (isInWishlist || isInBlacklist || isAlreadyLogged)
        {
            <p class="fr-movie-tags">
                @if (isAlreadyLogged) { <span class="fr-tag">In your log</span> }
                @if (isInWishlist) { <span class="fr-tag">In your Wishlist</span> }
                @if (isInBlacklist) { <span class="fr-tag">Not interested</span> }
            </p>
        }

        <div class="fr-movie-actions">
            <a class="fr-btn" asp-action="Add" asp-route-tmdbId="@Model.Id">@(isAlreadyLogged ? "Log again" : "Log it")</a>

            @* Wishlist and Not interested are mutually exclusive, so each only shows when the other is off *@
            @if (!isInWishlist && !isInBlacklist && !isAlreadyLogged)
            {
                <form asp-action="AddToWishlist" method="post">
                    <input type="hidden" name="tmdbId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="fr-btn fr-btn--secondary">Save to Wishlist</button>
                </form>
            }

            @if (trailerUrl != null)
            {
                <a class="fr-btn fr-btn--secondary" href="@trailerUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-fill" aria-hidden="true"></i> Trailer</a>
            }

            @if (isInWishlist || isInBlacklist || !isAlreadyLogged)
            {
                <details class="fr-more">
                    <summary aria-label="More actions for @Model.Title"><span aria-hidden="true">•••</span></summary>
                    <div class="fr-more-menu">
                        @if (isInWishlist)
                        {
                            <button type="button" data-movie-remove="wishlist" data-tmdb-id="@Model.Id">Remove from Wishlist</button>
                        }
                        else if (isInBlacklist)
                        {
                            <button type="button" data-movie-remove="blacklist" data-tmdb-id="@Model.Id">Show in suggestions again</button>
                        }
                        else
                        {
                            <form asp-action="AddToBlacklist" method="post">
                                <input type="hidden" name="tmdbId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit">Not interested</button>
                            </form>
                        }
                    </div>
                </details>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Overview))
        {
            <p class="fr-movie-overview">@Model.Overview</p>
        }

        <partial name="_MovieCast" model="Model.Credits?.Cast?.Take(4).ToList()" />
        <partial name="_MovieWhereToWatch" />
    </div>

    @* Anti-forgery token for the remove requests *@
    <form hidden>@Html.AntiForgeryToken()</form>
</article>

@section Scripts {
    <script src="~/js/movie-page.js" asp-append-version="true"></script>
}
